{
  "name": "hejmly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "license": "Elastic-2.0",
  "scripts": {
    "hooks:install": "lefthook install",
    "dev": "concurrently -k -n srv,web -c blue,green \"bun --hot apps/server/src/index.ts\" \"pnpm --filter @hejmly/web dev\"",
    "build": "pnpm --filter @hejmly/web build",
    "typecheck": "tsc -b",
    "test": "bun test",
    "check": "biome check .",
    "check:source": "bun ./scripts/check-source.ts",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "auth:generate": "pnpm dlx @better-auth/cli@1.4.21 generate --config better-auth.config.ts --output packages/core/src/server/auth/schema.ts --yes",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun ./scripts/migrate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/react": "19.2.17",
    "bun-types": "1.3.14",
    "concurrently": "9.2.4",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "lefthook": "2.1.10",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
